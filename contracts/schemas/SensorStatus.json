{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "last_seen": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Last Seen"
    },
    "status": {
      "enum": [
        "online",
        "offline",
        "unknown"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "id",
    "last_seen",
    "status"
  ],
  "title": "SensorStatus",
  "type": "object"
}
