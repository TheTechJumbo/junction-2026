{
  "$defs": {
    "Alert": {
      "additionalProperties": false,
      "properties": {
        "event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Event Ids",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "ts",
        "message",
        "event_ids"
      ],
      "title": "Alert",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            }
          ],
          "ge": 0,
          "le": 1,
          "title": "Confidence"
        },
        "evidence_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Evidence Url"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "object": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Object"
        },
        "source": {
          "enum": [
            "sensor",
            "vision",
            "voice"
          ],
          "title": "Source",
          "type": "string"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "zone": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Zone",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "source",
        "ts",
        "zone",
        "object",
        "evidence_url",
        "confidence"
      ],
      "title": "Event",
      "type": "object"
    },
    "QuestionCount": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "intent": {
          "title": "Intent",
          "type": "string"
        },
        "last_ts": {
          "format": "date-time",
          "title": "Last Ts",
          "type": "string"
        }
      },
      "required": [
        "intent",
        "count",
        "last_ts"
      ],
      "title": "QuestionCount",
      "type": "object"
    },
    "SensorStatus": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "last_seen": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Seen"
        },
        "status": {
          "enum": [
            "online",
            "offline",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "last_seen",
        "status"
      ],
      "title": "SensorStatus",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "alerts": {
      "items": {
        "$ref": "#/$defs/Alert"
      },
      "title": "Alerts",
      "type": "array"
    },
    "baseline": {
      "default": null,
      "title": "Baseline",
      "type": "null"
    },
    "day": {
      "format": "date",
      "title": "Day",
      "type": "string"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/Event"
      },
      "title": "Events",
      "type": "array"
    },
    "questions": {
      "items": {
        "$ref": "#/$defs/QuestionCount"
      },
      "title": "Questions",
      "type": "array"
    },
    "sensors": {
      "items": {
        "$ref": "#/$defs/SensorStatus"
      },
      "title": "Sensors",
      "type": "array"
    },
    "timezone": {
      "default": "Europe/Helsinki",
      "title": "Timezone",
      "type": "string"
    }
  },
  "required": [
    "events",
    "alerts",
    "questions",
    "sensors",
    "day"
  ],
  "title": "Timeline",
  "type": "object"
}
