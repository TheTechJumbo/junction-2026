# Copy privately to .env; these are placeholders, not credentials.
# Applications must explicitly load environment variables; this foundation does not load .env.
APP_TIMEZONE=Europe/Helsinki
DATABASE_URL=
TEST_DATABASE_URL=
LOCAL_DATA_DIR=.data
API_TOKEN=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
GEMINI_API_KEY=
VISION_RELAY_URL=
VISION_RELAY_KEY=
SENSOR_OFFLINE_SECONDS=30
EVIDENCE_MODE=local_only
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
SPEECH_TIMEOUT_SECONDS=0.8
# Comma-separated known devices; missing heartbeats remain unknown.
SENSOR_IDS=
# Only needed for a separately served client; /dashboard/ is same-origin.
ALLOWED_ORIGINS=
