<!-- Debug builds only: plain HTTP is allowed at the platform level so the phone can reach the laptop
     over adb reverse (127.0.0.1), from the emulator (10.0.2.2), or on the same Wi-Fi. The app's own
     checks still decide where plain HTTP may go: the home service only to loopback (BackendAddress),
     the Live 3D relay only to loopback and private LAN addresses (RelayAddress). Release builds use
     src/main/res/xml/network_security_config.xml: HTTPS only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
