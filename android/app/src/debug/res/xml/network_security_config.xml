<!-- Debug builds only: plain HTTP is allowed at the platform level so the phone can reach the laptop
     over adb reverse (127.0.0.1) or on the same Wi-Fi (private LAN addresses). The app's own clients
     (LocalHosts.cleartextAllowed) still refuse plain HTTP to anything but loopback and 10/8, 172.16/12
     and 192.168/16. Release builds use src/main/res/xml/network_security_config.xml: HTTPS only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
